# Copy to .env, then: docker compose up --build

# Required. Generate one with: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=

# Emails that become admins when they register (comma separated)
ADMIN_EMAILS=you@example.com
# Timezone for "today", day numbers and the 8pm lag check
TIMEZONE=UTC

# AI grading (articles show "not configured" until this is set)
ANTHROPIC_API_KEY=

# WhatsApp: console (log only) | meta
WHATSAPP_PROVIDER=console
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_LAG_TEMPLATE=

POSTGRES_PASSWORD=classtrack
WEB_PORT=8080
API_PORT=8000
