# Copy to .env and fill in. Never commit real values.

# Postgres. postgres:// and postgresql:// URLs (Render, Neon, Supabase) are accepted as-is.
#   local:  postgresql+psycopg://classtrack:classtrack@localhost:5432/classtrack
#   Neon:   postgresql://USER:PASSWORD@HOST.neon.tech/DBNAME?sslmode=require
DATABASE_URL=postgresql+psycopg://classtrack:classtrack@localhost:5432/classtrack
# Required in production. Generate: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=replace-with-a-long-random-string
# Users who register with these emails become admins (comma separated)
ADMIN_EMAILS=you@example.com
# Timezone for "today", day numbers, the nightly lag check and the Friday Drop
TIMEZONE=Africa/Nairobi
# Let admins see members' job applications (off = private to each member)
ADMIN_CAN_VIEW_JOB_APPLICATIONS=false

# AI grading (grading is skipped if unset)
ANTHROPIC_API_KEY=
GRADING_MODEL=claude-opus-5

# WhatsApp: console (log only) | meta
WHATSAPP_PROVIDER=console
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_LAG_TEMPLATE=

SCHEDULER_ENABLED=true
LAG_CHECK_HOUR=20
WEEKLY_DIGEST_DAY=sun
# Browser origins allowed to call the API (comma separated, scheme included, no path).
# Keep the localhost entries for dev and add the deployed frontend, e.g.
#   CORS_ORIGINS=https://classtrack-web.onrender.com,http://localhost:5173
# Read at startup: after changing it on Render, the API must redeploy/restart.
CORS_ORIGINS=http://localhost:3000,http://localhost:5173

# --- Friday Drop and quizzes ---
SPECIALIZATIONS=data_engineering,data_science,software_engineering,ai_engineering,embedded_iot,general
WEEKLY_DROP_DAY=fri
WEEKLY_DROP_HOUR=8
# first | last Friday of the month gets the interview-prep and course quizzes
MONTHLY_QUIZ_WEEK=first
# Model for summaries, quiz and exercise generation (blank = GRADING_MODEL)
QUIZ_MODEL=
# true = generated quizzes start as drafts until an admin publishes them
REQUIRE_QUIZ_REVIEW=false
# Used for links in WhatsApp messages
FRONTEND_URL=http://localhost:5173
# Approved Meta template with one body parameter, for drops and admin alerts
WHATSAPP_WEEKLY_TEMPLATE=
# Secret for POST /internal/jobs/weekly-drop (X-Job-Token header). Unset = endpoint off.
JOB_TOKEN=

# --- Coding exercises ---
# none = members run code in their browser (unverified, reduced points)
# remote = an external Judge0-compatible sandbox runs all tests. Never runs on this host.
CODE_RUNNER=none
CODE_RUNNER_URL=
CODE_RUNNER_KEY=
